    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1027> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1026> ] ;
    sdo:birthDate "1852-06-05"^^xsd:date ;
    sdo:birthPlace "Bodegraven" ;
    sdo:deathDate "1852-08-13"^^xsd:date ;
    sdo:deathPlace "Bodegraven" ;
    sdo:familyName "van der Sloot" ;
    sdo:gender sdo:Male ;
