@prefix picom: <https://personsincontext.org/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sdo: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://gen.example.com/stamboom/I0255> a picom:PersonReconstruction ;
    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1133> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1137> ] ;
    sdo:birthDate "1820-11-30"^^xsd:date ;
    sdo:birthPlace "Roden" ;
    sdo:deathDate "1835-02-06"^^xsd:date ;
    sdo:deathPlace "Roden (Ter Heijl)" ;
    sdo:familyName "ter Velde" ;
    sdo:gender sdo:Female ;
    sdo:givenName "Grietje" ;
    sdo:name "Grietje ter Velde" .

