    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S0733> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S0733> ] ;
    sdo:birthDate "1840-01-09"^^xsd:date ;
    sdo:birthPlace "Leiden" ;
    sdo:deathDate "1840-01-09"^^xsd:date ;
