    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1114> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1113> ] ;
    sdo:birthDate "1820-10-09"^^xsd:date ;
    sdo:birthPlace "Leek" ;
    sdo:deathDate "1821-10-10"^^xsd:date ;
