@prefix picom: <https://personsincontext.org/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sdo: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://gen.example.com/stamboom/I0254> a picom:PersonReconstruction ;
    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1140> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1132> ] ;
    sdo:birthDate "1819-01-16"^^xsd:date ;
    sdo:birthPlace "Roden" ;
    sdo:deathDate "1841-07-09"^^xsd:date ;
    sdo:deathPlace "Den Haag" ;
    sdo:familyName "van der Velde" ;
    sdo:gender sdo:Male ;
    sdo:givenName "Pieter" ;
    sdo:name "Pieter van der Velde" .

