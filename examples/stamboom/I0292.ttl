    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1200> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1199> ] ;
    sdo:birthDate "1882-02-01"^^xsd:date ;
    sdo:birthPlace "'s-Hertogenbosch" ;
    sdo:deathDate "1882-03-18"^^xsd:date ;
