@prefix picom: <https://personsincontext.org/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sdo: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://gen.example.com/stamboom/I0354> a picom:PersonReconstruction ;
    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1318> ] ;
    sdo:birthDate "1817-07-13"^^xsd:date ;
    sdo:birthPlace "'s-Gravenzande" ;
    sdo:familyName "van den Berg" ;
    sdo:gender sdo:Male ;
    sdo:givenName "NN" ;
    sdo:name "NN van den Berg" .

