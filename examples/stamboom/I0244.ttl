@prefix picom: <https://personsincontext.org/model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sdo: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://gen.example.com/stamboom/I0244> a picom:PersonReconstruction ;
    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1115> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1112> ] ;
    sdo:birthDate "1818-11-02"^^xsd:date ;
    sdo:birthPlace "Leek" ;
    sdo:deathDate "1846-09-28"^^xsd:date ;
    sdo:deathPlace "Leek" ;
    sdo:familyName "Raven" ;
    sdo:gender sdo:Male ;
    sdo:givenName "Geert" ;
    sdo:name "Geert Raven" .

