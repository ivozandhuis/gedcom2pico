    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1410> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S1403> ] ;
    sdo:birthDate "1860-02-14"^^xsd:date ;
    sdo:birthPlace "Lemmer" ;
    sdo:deathDate "1860-08-23"^^xsd:date ;
    sdo:deathPlace "Lemmer" ;
    sdo:familyName "Duit" ;
