    prov:wasDerivedFrom [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S0716> ],
        [ a picom:PersonObservation ;
            prov:hadPrimarySource <https://gen.example.com/stamboom/S0711> ] ;
    sdo:birthDate "1840-01-11"^^xsd:date ;
    sdo:birthPlace "Oud-Valkenburg" ;
    sdo:deathDate "1878-04-02"^^xsd:date ;
